<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Gallery | Stella Dallas Tennis</title>

  <style>
    :root {
      --green: #0b5d3b;
      --dark-green: #073b28;
      --yellow: #dfff00;
      --light: #f5f7f6;
      --white: #ffffff;
      --gray: #667085;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--light);
      color: #17201b;
    }

    header {
      background: var(--green);
      color: white;
      padding: 18px 20px;
    }

    .header-inner {
      max-width: 1100px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .ball {
      width: 42px;
      height: 42px;
      background: var(--yellow);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 23px;
    }

    .logo h1 {
      font-size: 21px;
    }

    .logo span {
      display: block;
      font-size: 11px;
      opacity: .8;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: bold;
      font-size: 14px;
    }

    nav a:hover {
      color: var(--yellow);
    }

    .hero {
      background: var(--dark-green);
      color: white;
      padding: 60px 20px;
    }

    .hero-inner {
      max-width: 1100px;
      margin: auto;
    }

    .hero h2 {
      font-size: 50px;
      margin-bottom: 10px;
    }

    .hero h2 span {
      color: var(--yellow);
    }

    .hero p {
      color: #d5e4dc;
      font-size: 17px;
    }

    main {
      max-width: 1100px;
      margin: auto;
      padding: 50px 20px 80px;
    }

    .event-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .event-card {
      background: white;
      border-radius: 16px;
      padding: 30px;
      box-shadow: 0 5px 20px rgba(0,0,0,.07);
      transition: .2s;
    }

    .event-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 25px rgba(0,0,0,.12);
    }

    .event-icon {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .event-card h3 {
      color: var(--green);
      font-size: 24px;
      margin-bottom: 8px;
    }

    .event-card p {
      color: var(--gray);
      margin-bottom: 22px;
    }

    .view-button {
      display: inline-block;
      background: var(--green);
      color: white;
      padding: 11px 17px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
      font-size: 14px;
    }

    .view-button:hover {
      background: var(--dark-green);
    }

    footer {
      background: var(--dark-green);
      color: white;
      text-align: center;
      padding: 30px;
      font-size: 13px;
    }

    @media (max-width: 800px) {
      .event-grid {
        grid-template-columns: 1fr;
      }

      .header-inner {
        flex-direction: column;
        gap: 15px;
      }

      .hero h2 {
        font-size: 40px;
      }
    }
  </style>
</head>

<body>

  <header>

    <div class="header-inner">

      <div class="logo">

        <div class="ball">🎾</div>

        <div>
          <h1>Stella Dallas Tennis</h1>
          <span>Friends • Tennis • Competition</span>
        </div>

      </div>

      <nav>
        <a href="index.html">← Main Site</a>
      </nav>

    </div>

  </header>


  <section class="hero">

    <div class="hero-inner">

      <h2>Photo <span>Gallery</span></h2>

      <p>
        Memories from our tournaments and events.
      </p>

    </div>

  </section>


  <main>

    <div class="event-grid">

      <!-- LABOR DAY -->

      <div class="event-card">

        <div class="event-icon">🎾</div>

        <h3>Labor Day Event</h3>

        <p>
          Photos from our Labor Day tennis event.
        </p>

        <a class="view-button" href="labor-day.html">
          View Photos →
        </a>

      </div>


      <!-- FALL BREAK -->

      <div class="event-card">

        <div class="event-icon">🎾</div>

        <h3>Fall Break Event</h3>

        <p>
          Photos from our Fall Break event.
        </p>

        <a class="view-button" href="fall-break.html">
          View Photos →
        </a>

      </div>


      <!-- HOLIDAY -->

      <div class="event-card">

        <div class="event-icon">🎾</div>

        <h3>Holiday Event</h3>

        <p>
          Photos from our holiday tournament.
        </p>

        <a class="view-button" href="holiday.html">
          View Photos →
        </a>

      </div>

    </div>

  </main>


  <footer>

    © 2026 Stella Dallas Tennis • Court time is the best time.

  </footer>

</body>

</html>
